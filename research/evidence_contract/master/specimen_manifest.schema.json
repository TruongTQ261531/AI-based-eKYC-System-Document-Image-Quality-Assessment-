{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Draft fictional specimen metadata, without author transcript or personal identity",
  "type": "object",
  "required": ["schema", "state", "rows"],
  "properties": {
    "schema": {"const": "evidence-specimen-draft/1"},
    "state": {"const": "DRAFT_ONLY"},
    "rows": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "uid", "physical_id", "data_policy", "layout", "lineage", "image_relpath", "rights_basis",
                     "file_sha256", "pixel_sha256", "content_sha256", "reference_verified", "provenance_verified"],
        "properties": {
          "role": {"enum": ["development", "prospective_confirmatory"]},
          "uid": {"type": "string", "minLength": 1},
          "physical_id": {"type": "string", "minLength": 1},
          "data_policy": {"const": "fictional"},
          "layout": {"type": "string", "minLength": 1},
          "lineage": {"type": "string", "minLength": 1},
          "image_relpath": {"type": "string", "minLength": 1},
          "rights_basis": {"type": "string", "minLength": 1},
          "file_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "pixel_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "reference_verified": {"type": "boolean"},
          "provenance_verified": {"type": "boolean"}
        }
      }
    }
  }
}
